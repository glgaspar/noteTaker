{
  "private": true,
  "scripts": {
    "build": "node scripts/assets.mjs && esbuild web/app.js --bundle --minify --outfile=static/dist/app.js && tailwindcss -i web/app.css -o static/dist/app.css --minify",
    "watch:js": "esbuild web/app.js --bundle --outfile=static/dist/app.js --watch",
    "watch:css": "tailwindcss -i web/app.css -o static/dist/app.css --watch"
  },
  "dependencies": {
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-code-block-lowlight": "^3.32.2",
