{
  "private": true,
  "scripts": {
    "build": "esbuild web/app.js --bundle --minify --outfile=static/dist/app.js && tailwindcss -i web/app.css -o static/dist/app.css --minify",
    "watch:js": "esbuild web/app.js --bundle --outfile=static/dist/app.js --watch",
    "watch:css": "tailwindcss -i web/app.css -o static/dist/app.css --watch"
  },
  "dependencies": {
    "htmx.org": "^2.0.11"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  }
}
